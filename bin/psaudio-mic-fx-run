#!/bin/bash
# Headset mic -> (effect) -> the console's mic input. Restarted by `psaudio-ctl effect …`.
. /usr/local/lib/psaudio/common.sh
EFFECT=$(cat "$STATE/current-effect" 2>/dev/null || echo normal)

# The devices can show up a few seconds after PipeWire; wait for them.
for _ in $(seq 1 30); do
  SRC=$(resolve HEADSET_SOURCE); DST=$(resolve GADGET_SINK)
  [ -n "$SRC" ] && [ -n "$DST" ] && break
  sleep 2
done
[ -n "$SRC" ] && [ -n "$DST" ] || { echo "psaudio-mic-fx: headset mic or console not found" >&2; exit 1; }

case "$EFFECT" in
  radio)      FILTER="highpass=f=300,lowpass=f=3400,aecho=in_gain=0.8:out_gain=0.7:delays=30:decays=0.3,acompressor=threshold=-20dB:ratio=4:attack=5:release=50,volume=1.5" ;;
  pitch_high) FILTER="asetrate=38400,aresample=48000" ;;
  pitch_low)  FILTER="asetrate=57600,aresample=48000" ;;
  robot)      FILTER="aecho=in_gain=0.8:out_gain=0.8:delays=10|20:decays=0.8|0.6,highpass=f=200" ;;
  *)          FILTER=anull ;;
esac

echo "psaudio-mic-fx: effect=$EFFECT $SRC -> $DST" >&2

if [ "$FILTER" = anull ]; then
  # No effect: a native PipeWire loopback. It resamples adaptively between the headset's and
  # the console's USB clocks, so the delay stays ~30 ms however long it runs. (ffmpeg | pacat
  # can't: the clock difference piled up in its buffers, ~40 s behind after a day.)
  exec pw-loopback --name psaudio-mic-fx --channels 1 --channel-map "[ MONO ]" --latency 30 \
    --capture "$SRC" --playback "$DST" \
    --capture-props "node.name=psaudio-mic-in media.name=psaudio-mic-in" \
    --playback-props "node.name=psaudio-mic-fx media.name=psaudio-mic-fx"
fi

# Effects need ffmpeg, which can't follow the console's clock: restart it every 15 min so the
# drift can never build up past a fraction of a second (a ~0.3 s blip each time).
while true; do
  /usr/bin/ffmpeg -f pulse -fragment_size 960 -i "$SRC" -t 900 -af "$FILTER" -ar 48000 -ac 1 -f s16le - 2>/dev/null | \
    pacat --playback --format=s16le --rate=48000 --channels=1 --latency-msec=40 \
          --device="$DST" --stream-name="psaudio-mic-fx"
  sleep 0.2
done
