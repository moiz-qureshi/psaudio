#!/bin/bash
# aibuddy - drive psaudio-buddy (Gemini voice on the PS5 audio Pi) from the deck.
#   aibuddy press | release | stop | toggle | arm | disarm | vol up|down [N] | status
#   aibuddy mic        toggle the headset mic to the PS5 (reads the real mute state from the Pi)
# Token: ~/.config/ragnaros/secrets/aibuddy.env (BUDDY_URL, BUDDY_TOKEN), mode 600.
set -u
. "$HOME/.config/ragnaros/secrets/aibuddy.env"
t=$(date +%s%3N)   # client timestamp, for the latency log
call() { curl -s -m "${2:-3}" -X POST -H "Authorization: Bearer $BUDDY_TOKEN" "$BUDDY_URL$1"; }
case "${1:-status}" in
  press|release|stop|toggle|arm|disarm) call "/$1?t=$t" 15 ;;
  vol) case "${2:-}" in
         up) call "/volume?up=${3:-10}" ;;
         down) call "/volume?down=${3:-10}" ;;
         *) call "/volume?set=${2:-70}" ;;
       esac ;;
  mic) if curl -s -m 3 -H "Authorization: Bearer $BUDDY_TOKEN" "$BUDDY_URL/status" | grep -q '"mic_muted": true'; then
         "$HOME/.config/ragnaros/bin/psaudio" mic_unmute && ragnarosctl toast "MIC" "live to PS5" --seconds=2
       else
         "$HOME/.config/ragnaros/bin/psaudio" mic_mute && ragnarosctl toast "MIC" "muted" --seconds=2
       fi ;;
  status) curl -s -m 3 -H "Authorization: Bearer $BUDDY_TOKEN" "$BUDDY_URL/status" ;;
  *) echo "usage: aibuddy press|release|stop|toggle|arm|disarm|vol up|down [N]|mic|status" >&2; exit 2 ;;
esac
