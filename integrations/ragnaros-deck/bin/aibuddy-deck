#!/usr/bin/env python3
"""Mirror psaudio-buddy's state onto the deck: long-polls the Pi and swaps the
icons of keys tagged `state: aibuddy` / `state: aisession` / `state: aivol`
through ragnarosd-plus's `keystate` verb. Errors also show as a strip toast."""
import json
import os
import subprocess
import time
import urllib.request

from ragnaros import control

ENV = os.path.expanduser("~/.config/ragnaros/secrets/aibuddy.env")
SOCK = os.path.expanduser("~/.local/state/ragnaros-plus/ctl.sock")


def env():
    out = {}
    for line in open(ENV):
        if "=" in line and not line.startswith("#"):
            k, v = line.strip().split("=", 1)
            out[k] = v.strip('"')
    return out


def ctl(*argv):
    try:
        control.request(list(argv), path=SOCK)
    except (OSError, ValueError):
        pass


def toast(title, body):
    subprocess.Popen(["ragnarosctl", "toast", title, body, "--seconds=4"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


LIVE = os.path.expanduser("~/.local/state/ragnaros-plus/aibuddy.json")


def snapshot(st):
    """What the deck's live strip shows (ragnarosd-plus reads this file)."""
    data = {"ts": time.time(), "state": st.get("state"), "error": st.get("error"),
            "profile": (st.get("profile") or {}).get("label"), "session_on": st.get("session_on"),
            "mic_muted": st.get("mic_muted"), "question": (st.get("question") or "")[-200:],
            "reply": (st.get("reply") or "")[-400:], "ai_volume": st.get("ai_volume"),
            "listening_source": st.get("listening_source")}
    tmp = LIVE + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, LIVE)
    except OSError:
        pass


def main():
    e = env()
    url, token = e["BUDDY_URL"], e["BUDDY_TOKEN"]
    seq, last, last_err, last_session, last_crcmz = -1, None, None, None, None
    while True:
        try:
            req = urllib.request.Request(f"{url}/status?since={seq}&wait=25",
                                         headers={"Authorization": f"Bearer {token}"})
            st = json.load(urllib.request.urlopen(req, timeout=35))
            seq = st["seq"]
            state = st["state"]
            snapshot(st)
            roast_turn = st.get("turn_mode") == "roast"
            if (state, roast_turn) != last:
                ctl("keystate", "aibuddy", state)
                # the ROAST key lights up only while a roast is being taken / spoken
                ctl("keystate", "airoast", state if roast_turn and state in ("listening", "thinking", "speaking") else "idle")
                last = (state, roast_turn)
            session = "on" if st.get("session_on") else "off"
            if session != last_session:
                ctl("keystate", "aisession", session)    # state shows on the key + live strip, no toast
                last_session = session
            # toasts only for problems worth interrupting the strip for; everything
            # else (state, model, session, volume, who asked) is on the live strip
            if state == "error" and st.get("error") != last_err:
                toast("HASAAN", st.get("error") or "error")
            last_err = st.get("error") if state == "error" else None
            crcmz_err = (st.get("crcmz") or {}).get("error")
            if crcmz_err and crcmz_err != last_crcmz:
                toast("CRCMZ", "lookups unavailable: " + crcmz_err[:60])
            last_crcmz = crcmz_err
        except Exception:
            snapshot({"state": "offline"})
            if last != "offline":
                ctl("keystate", "aibuddy", "offline")
                last = "offline"
            seq = -1
            time.sleep(3)


if __name__ == "__main__":
    main()
