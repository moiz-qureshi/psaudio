[Unit]
Description=PS Audio Bridge route guard (streams back on their own devices after a headset drop)
After=pipewire.service pipewire-pulse.service
Requires=pipewire.service pipewire-pulse.service

[Service]
Type=simple
Environment=PULSE_RUNTIME_PATH=%t/pulse
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/psaudio-route-guard
Restart=always
RestartSec=2s

[Install]
WantedBy=default.target
